---
export interface Props {
  name: string;
  role: string;
  gender: string;
  age: string;
  responsibilities: string;
  mbti: string;
  zodiac: string;
  avatar?: string;
}

const { name, role, gender, age, responsibilities, mbti, zodiac, avatar } = Astro.props;

const genderEmoji = gender === '男' ? '♂' : gender === '女' ? '♀' : '⚧';
const genderBgColor = gender === '男' ? 'bg-blue-100' : gender === '女' ? 'bg-pink-100' : 'bg-gray-100';

const mbtiColors: Record<string, string> = {
  INTJ: 'bg-purple-200 text-purple-800',
  INFJ: 'bg-indigo-200 text-indigo-800',
  INTP: 'bg-green-200 text-green-800',
  INFP: 'bg-pink-200 text-pink-800',
  ENTJ: 'bg-red-200 text-red-800',
  ENFJ: 'bg-orange-200 text-orange-800',
  ENTP: 'bg-yellow-200 text-yellow-800',
  ENFP: 'bg-rose-200 text-rose-800',
  ISTJ: 'bg-blue-200 text-blue-800',
  ISFJ: 'bg-sky-200 text-sky-800',
  ISTP: 'bg-teal-200 text-teal-800',
  ISFP: 'bg-emerald-200 text-emerald-800',
  ESTJ: 'bg-slate-200 text-slate-800',
  ESFJ: 'bg-coral-200 text-coral-800',
  ESTP: 'bg-amber-200 text-amber-800',
  ESFP: 'bg-lime-200 text-lime-800',
};

const mbtiColor = mbtiColors[mbti] || 'bg-gray-200 text-gray-800';
---

<div class="group bg-surface rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 overflow-hidden flex flex-col">
  <div class="h-32 bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent"></div>
    <div class="w-20 h-20 rounded-full bg-white/80 backdrop-blur flex items-center justify-center shadow-lg overflow-hidden">
      {avatar ? (
        <img src={avatar} alt={name} class="w-full h-full object-cover" />
      ) : (
        <span class="text-3xl font-bold text-primary">{name.charAt(0)}</span>
      )}
    </div>
  </div>
  
  <div class="p-6 flex flex-col flex-1">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-xl font-bold text-text-primary">{name}</h3>
      <span class="px-3 py-1 bg-primary/10 text-primary text-sm font-normal rounded-full">
        {role}
      </span>
    </div>
    
    <p class="text-sm text-text-secondary mb-4 flex-1">{responsibilities}</p>
    
    <div class="flex flex-wrap gap-2 text-sm text-text-secondary">
      <span class={`px-2 py-1 rounded ${genderBgColor}`}>{genderEmoji}</span>
      <span class="px-2 py-1 bg-gray-100 rounded">{zodiac}</span>
      <span class={`px-2 py-1 rounded ${mbtiColor}`}>{mbti}</span>
      <span class="px-2 py-1 bg-gray-100 rounded">{age}</span>
    </div>
  </div>
</div>