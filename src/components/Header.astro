---
const siteTitle = SITE_TITLE;
---

<header class="bg-gradient-to-r from-secondary via-primary/10 to-secondary text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-white via-primary-light to-white bg-clip-text text-transparent">
        {siteTitle}
      </h1>
      <p class="mt-4 text-lg text-gray-300 max-w-2xl mx-auto">
        数字员工团队 - 为人生集团公司提供智能化服务与协作支持
      </p>
    </div>
  </div>
</header>